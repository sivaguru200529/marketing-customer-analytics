# ==============================================================================
# Aura Retail Database Configuration Template
# Copy this file to "database.ini" and update credentials if using a custom host.
# ==============================================================================

[postgresql]
host = localhost
port = 5432
database = aura_retail_db
user = postgres
password = postgres_secure_password
schema = public

[sqlite_fallback]
# Used if PostgreSQL is unavailable or for offline testing
enabled = true
db_path = data/aura_retail.db
